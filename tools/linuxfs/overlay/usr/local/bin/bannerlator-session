#!/bin/bash
# The Linux runtime's session. Bannerlator execs this under proot with the output size and mode;
# the first pass starts gamescope, which execs this script again inside it for the program:
#   bannerlator-session steam [steam-url]  el cliente nativo de Steam
#   bannerlator-session run <path>         un programa Linux auxiliar
# Los modos históricos "desktop"/"lxqt" se redirigen a Steam en esta edición.
# BL_WIDTH / BL_HEIGHT size the output, BL_FPS limits it, BL_LOG collects everything said here.
set -u
export HOME=${HOME:-/root}
mode=${1:-steam}
shift || true
# Steam-only: evita que accesos directos o helpers antiguos vuelvan a iniciar LXQt.
if [ "$mode" = lxqt ] || [ "$mode" = desktop ]; then
  echo "== modo de escritorio heredado redirigido a Steam"
  mode=steam
fi
# One line per milestone, greppable as "== STEP", so a first run reads as a narrative rather than
# something to be reconstructed from Steam's own chatter. The app shows these while it waits.
step() { echo "== STEP $(date -u +%H:%M:%S) $*"; }
if [ -n "${BL_LOG:-}" ] && [ -z "${BL_INSIDE:-}" ]; then
  mkdir -p "$(dirname "$BL_LOG")" 2>/dev/null
  # The client alone writes megabytes an hour; one earlier log is kept, not every session's.
  if [ "$(stat -c %s "$BL_LOG" 2>/dev/null || echo 0)" -gt 8388608 ]; then
    mv -f "$BL_LOG" "$BL_LOG.1"
  fi
  # A guest looping on an error writes gigabytes in minutes (an Xwayland proot had lost track of
  # managed 9 GB of one line in 19 min): the log keeps its first BL_LOG_CAP bytes and the rest is
  # drained, not refused - a writer that filled it must not die of SIGPIPE.
  exec > >({ head -c "${BL_LOG_CAP:-268435456}" >>"$BL_LOG"; cat >/dev/null; }) 2>&1
  echo "== bannerlator-session $(date) modo=$mode $*"
  echo "== uid=$(id -u) tamaño=${BL_WIDTH:-?}x${BL_HEIGHT:-?} fps=${BL_FPS:-0} icd=${VK_ICD_FILENAMES:-ninguno}"
  echo "== gamescope: $(gamescope --version 2>&1 | head -1) en $(command -v gamescope)"
  echo "== rootfs: $(cat /.version 2>/dev/null || echo sin-versión)"
fi

# Until the runtime is stable, Steam's own logs are copied beside the session log at exit so a
# failed launch can be handed over as one folder.
collect_steam_logs() {
  [ -n "${BL_DEBUG_DIR:-}" ] || return 0
  local steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
  mkdir -p "$BL_DEBUG_DIR/steam" 2>/dev/null || return 0
  # Into steam/ beside this session's own logs. The app scrubs these line by line after the
  # session ends - they carry the account's session token and id - so nothing here is the last
  # word on what the user ends up sharing; this is just the copy that survives the runtime.
  [ -d "$steam_root/logs" ] && cp -r "$steam_root/logs/." "$BL_DEBUG_DIR/steam/" 2>/dev/null
  [ -f "$HOME/.steam/steam/logs/steamwebhelper.log" ] && cp "$HOME/.steam/steam/logs/steamwebhelper.log" "$BL_DEBUG_DIR/steam/" 2>/dev/null
  # NOT copied, ever: loginusers.vdf, config.vdf and the ssfn* files, which hold the credentials
  # themselves rather than a mention of them.
  echo "== registros de Steam copiados en $BL_DEBUG_DIR/steam"
}
# A session that is killed never reaches the copy below, and those are the sessions worth reading.
trap 'collect_steam_logs 2>/dev/null || true' TERM INT HUP
# The driver everything in this session draws with: gamescope's compositing, the client's UI
# (OpenGL through Zink) y cada juego que Proton inicia.
# BL_VK_DRIVER names an imported driver's ICD manifest on the Android side, which is bound into the
# session at its own path; unset means the runtime keeps the matching Vulkan ICD it was built with.
# VK_DRIVER_FILES REPLACES the loader's search, so a manifest whose library is unreadable would
# leave the session with no Vulkan at all - check both before setting it, and say so in the log
# rather than fail silently half a minute later.
if [ -n "${BL_VK_DRIVER:-}" ]; then
  bl_icd_lib=$(sed -n 's/.*"library_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$BL_VK_DRIVER" 2>/dev/null | head -1)
  # JSON may escape the separator: org.json writes "\/data\/user\/0\/...". The Vulkan loader
  # parses that correctly; this check has to as well, or an absolute path looks relative and gets
  # glued onto the manifest's directory - which is exactly what happened the first time.
  bl_icd_lib=$(printf '%s' "$bl_icd_lib" | sed 's|\\/|/|g')
  case $bl_icd_lib in
    /*) ;;
    ?*) bl_icd_lib="$(dirname "$BL_VK_DRIVER")/$bl_icd_lib" ;;
  esac
  if [ -r "$BL_VK_DRIVER" ] && [ -n "$bl_icd_lib" ] && [ -r "$bl_icd_lib" ]; then
    export VK_DRIVER_FILES="$BL_VK_DRIVER"
    # Loaders older than 1.3.207 only know the old name; both are harmless together.
    export VK_ICD_FILENAMES="$BL_VK_DRIVER"
    # Generic Mesa/Mali ICD packages may carry helper .so files beside the selected ICD. Let the
    # glibc loader resolve those helpers from the imported package without copying them into /usr.
    bl_icd_dir=$(dirname "$bl_icd_lib")
    export LD_LIBRARY_PATH="$bl_icd_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    echo "== controlador Vulkan: importado $bl_icd_lib (mediante $BL_VK_DRIVER)"
    BL_SELECTED_ICD_LIB="$bl_icd_lib"

    # Fail here with a useful list instead of letting gamescope turn a missing helper library into
    # a black screen. This is especially useful for PanVK-Kbase packages that carry Mesa helpers.
    if command -v ldd >/dev/null 2>&1; then
      bl_ldd=$(LD_LIBRARY_PATH="$LD_LIBRARY_PATH" ldd "$bl_icd_lib" 2>&1 || true)
      bl_missing=$(printf '%s\n' "$bl_ldd" | sed -n 's/^[[:space:]]*\([^[:space:]]*\)[[:space:]]*=>[[:space:]]*not found.*/\1/p' | sort -u | tr '\n' ' ')
      if [ -n "$bl_missing" ]; then
        echo "== preflight Vulkan FALLÓ: faltan bibliotecas en el guest: $bl_missing"
        echo "== preflight Vulkan, salida de ldd:"
        printf '%s\n' "$bl_ldd"
        exit 78
      fi
      unset bl_ldd bl_missing
    fi
  else
    echo "== controlador Vulkan: SE IGNORA $BL_VK_DRIVER (manifiesto o ${bl_icd_lib:-biblioteca} ilegible); se usa el del runtime"
  fi
  unset bl_icd_lib bl_icd_dir
fi
if [ "${BL_GPU_FAMILY:-}" = "mali" ]; then
  echo "== backend Mali: ${BL_GUEST_GPU:-desconocido}${BL_DRM_RENDER_NODE:+ render=$BL_DRM_RENDER_NODE}"
  if [ "${BL_GUEST_GPU:-}" = "mali_kbase" ]; then
    echo "== Mali Kbase: frontend=${BL_MALI_KBASE_FRONTEND:-desconocido} UAPI=${BL_MALI_KBASE_UAPI:-desconocido} producto=${BL_MALI_PRODUCT_ID:-desconocido} gpu-id=${BL_MALI_GPU_ID:-desconocido} perfil=${BL_MALI_PROFILE:-sin-calificar} núcleos=${BL_MALI_SHADER_CORES:-desconocido}"
    if [ ! -e /dev/mali0 ]; then
      echo "== preflight Mali Kbase FALLÓ: /dev/mali0 funcionaba en Android pero no es visible dentro del guest"
      exit 77
    fi
    # Stage 5: validate the real guest graphics stack once per GPU/Kbase/ICD combination. The
    # marker is written only after Vulkan + optional Zink + a tiny gamescope launch all succeed.
    # This catches a driver that merely enumerates but cannot feed Steam's GL UI or the compositor.
    if [ -n "${BL_VK_DRIVER:-}" ] && [ -n "${BL_SELECTED_ICD_LIB:-}" ]; then
      _bl_icd_hash=$(sha256sum "$BL_SELECTED_ICD_LIB" 2>/dev/null | awk '{print $1}')
      [ -n "$_bl_icd_hash" ] || _bl_icd_hash=$(basename "$BL_SELECTED_ICD_LIB" | tr -cd 'A-Za-z0-9._-')
      BL_MALI_PREFLIGHT_MARKER="${XDG_CACHE_HOME:-$HOME/.cache}/droiddeck/mali-preflight/v4-${BL_MALI_KBASE_FRONTEND:-unknown}-${BL_MALI_PRODUCT_ID:-unknown}-${BL_MALI_KBASE_UAPI:-unknown}-${BL_MALI_PROFILE:-unqualified}-${_bl_icd_hash}.ok"
      mkdir -p "$(dirname "$BL_MALI_PREFLIGHT_MARKER")" 2>/dev/null || true
      if [ -f "$BL_MALI_PREFLIGHT_MARKER" ]; then
        echo "== preflight Mali Kbase: resultado en caché correcto"
      else
        if command -v vulkaninfo >/dev/null 2>&1; then
          echo "== preflight Mali Kbase: enumeración Vulkan"
          if command -v timeout >/dev/null 2>&1; then
            bl_vk_probe=$(timeout 12s env PANVK_DEBUG="${PANVK_DEBUG:-startup}" vulkaninfo --summary 2>&1); bl_vk_rc=$?
          else
            bl_vk_probe=$(env PANVK_DEBUG="${PANVK_DEBUG:-startup}" vulkaninfo --summary 2>&1); bl_vk_rc=$?
          fi
          if [ "$bl_vk_rc" -ne 0 ]; then
            echo "== preflight Vulkan sobre Mali Kbase FALLÓ rc=$bl_vk_rc"
            printf '%s\n' "$bl_vk_probe" | tail -80
            exit 79
          fi
          if printf '%s\n' "$bl_vk_probe" | grep -Eqi 'llvmpipe|lavapipe|software rasterizer|LLVMpipe'; then
            echo "== preflight Vulkan sobre Mali Kbase FALLÓ: se detectó un fallback Vulkan por software"
            printf '%s\n' "$bl_vk_probe" | grep -Ei 'deviceName|driverName|apiVersion|driverInfo|llvmpipe|lavapipe' | head -20 || true
            exit 82
          fi
          printf '%s\n' "$bl_vk_probe" | grep -E 'deviceName|driverName|apiVersion|driverInfo' | head -12 || true

          echo "== preflight Mali Kbase: extensión Vulkan Wayland WSI"
          if command -v timeout >/dev/null 2>&1; then
            timeout 12s vulkaninfo 2>&1 | grep -Fq 'VK_KHR_wayland_surface'
            bl_wayland_wsi_rc=$?
          else
            vulkaninfo 2>&1 | grep -Fq 'VK_KHR_wayland_surface'
            bl_wayland_wsi_rc=$?
          fi
          if [ "$bl_wayland_wsi_rc" -ne 0 ]; then
            echo "== preflight Vulkan sobre Mali Kbase FALLÓ: el ICD no expone VK_KHR_wayland_surface"
            exit 84
          fi
          echo "== preflight Mali Kbase: VK_KHR_wayland_surface disponible"
          unset bl_vk_probe bl_vk_rc bl_wayland_wsi_rc
        else
          echo "== preflight Mali Kbase: vulkaninfo no está disponible; gamescope hará la prueba Vulkan"
        fi

        # Steam's Chromium/ANGLE path is OpenGL through Zink. When Mesa's eglinfo is present,
        # exercise a surfaceless Zink context against the same Vulkan ICD before opening Steam.
        if command -v eglinfo >/dev/null 2>&1; then
          echo "== preflight Mali Kbase: Zink/EGL"
          if command -v timeout >/dev/null 2>&1; then
            bl_zink_probe=$(timeout 12s env EGL_PLATFORM=surfaceless MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink eglinfo -B 2>&1); bl_zink_rc=$?
          else
            bl_zink_probe=$(env EGL_PLATFORM=surfaceless MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink eglinfo -B 2>&1); bl_zink_rc=$?
          fi
          if [ "$bl_zink_rc" -ne 0 ]; then
            echo "== preflight Zink sobre Mali Kbase FALLÓ rc=$bl_zink_rc"
            printf '%s\n' "$bl_zink_probe" | tail -80
            exit 80
          fi
          printf '%s\n' "$bl_zink_probe" | grep -Ei 'vendor|renderer|version|zink' | head -16 || true
          unset bl_zink_probe bl_zink_rc
        fi
      fi
      unset _bl_icd_hash
    fi
  fi
  if [ "${VK_ICD_FILENAMES:-}" = "/nonexistent/droiddeck-mali-no-matching-icd.json" ]; then
    case ${BL_GUEST_GPU:-unknown} in
      mali_drm)
        echo "== controlador Vulkan: Mali DRM es accesible pero no hay un ICD PanVK/Panfrost instalado"
        ;;
      mali_kbase|mali_proprietary)
        echo "== controlador Vulkan: se detectó /dev/mali0 Kbase stock utilizable; se necesita un ICD PanVK glibc nativo para Kbase"
        echo "== controlador Vulkan: PanVK DRM normal NO se selecciona automáticamente para la ABI Kbase"
        ;;
      *)
        echo "== controlador Vulkan: se detectó Mali pero no se encontró una interfaz GPU utilizable dentro del guest"
        ;;
    esac
  fi
fi
# The app's gamescope build (tools/gamescope) takes realtime-priority Vulkan queues on this
# switch instead of on CAP_SYS_NICE, which proot never has; it falls back to normal priority
# where the driver refuses, and the runtime's own build ignores it.
export GAMESCOPE_FORCE_VULKAN_REALTIME=${BL_GAMESCOPE_REALTIME:-1}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

# Núcleos usados por un programa auxiliar fuera del cliente Steam: BL_GAME_CPUS cuando el usuario
# lo define; en caso contrario se evita el clúster más lento para no penalizar cargas intensivas. BL_PIN_CORES=0 leaves the scheduler alone.
program_cores() {
  [ "${BL_PIN_CORES:-1}" = 0 ] && return 0
  command -v taskset >/dev/null 2>&1 || return 0
  if [ -n "${BL_GAME_CPUS:-}" ]; then echo "$BL_GAME_CPUS"; return 0; fi
  local f n max min= list=
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    max=$(cat "$f" 2>/dev/null) || continue
    [ -z "$min" ] || [ "$max" -lt "$min" ] && min=$max
  done
  [ -n "$min" ] || return 0
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    max=$(cat "$f" 2>/dev/null) || continue
    n=${f#/sys/devices/system/cpu/cpu}; n=${n%%/*}
    [ "$max" -gt "$min" ] && list="$list${list:+,}$n"
  done
  echo "$list"
}

if [ -z "${BL_INSIDE:-}" ]; then
  # The compositor may still be starting, and a socket left by an earlier session is not
  # a compositor: probe until a connection succeeds.
  for _ in $(seq 1 100); do
    wayland-info >/dev/null 2>&1 && break
    sleep 0.1
  done
  # Complete the cached Stage-5 Mali preflight with the exact compositor binary and Wayland
  # backend the real Steam session uses. A 64x64 /bin/true client exits immediately; failure here
  # is much more useful than letting the user reach an unexplained black screen.
  if [ "$mode" = steam ] && [ "${BL_GUEST_GPU:-}" = mali_kbase ] \
     && [ -n "${BL_MALI_PREFLIGHT_MARKER:-}" ] && [ ! -f "$BL_MALI_PREFLIGHT_MARKER" ]; then
    echo "== preflight Mali Kbase: prueba mínima de gamescope/Wayland"
    _bl_smoke_log=$(mktemp /tmp/droiddeck-gamescope-smoke.XXXXXX)
    if command -v timeout >/dev/null 2>&1; then
      timeout 15s env VK_LOADER_DEBUG=error,warn gamescope --backend wayland --expose-wayland -W 64 -H 64 -w 64 -h 64 -- /bin/sleep 3 >"$_bl_smoke_log" 2>&1
      _bl_smoke_rc=$?
    else
      env VK_LOADER_DEBUG=error,warn gamescope --backend wayland --expose-wayland -W 64 -H 64 -w 64 -h 64 -- /bin/sleep 3 >"$_bl_smoke_log" 2>&1
      _bl_smoke_rc=$?
    fi
    if [ "$_bl_smoke_rc" -ne 0 ]; then
      echo "== preflight gamescope sobre Mali Kbase FALLÓ rc=$_bl_smoke_rc"
      tail -100 "$_bl_smoke_log" 2>/dev/null || true
      if grep -q 'vkCreateInstance failed' "$_bl_smoke_log" 2>/dev/null; then
        _bl_vk_instance=$(grep 'vkCreateInstance failed' "$_bl_smoke_log" | tail -1)
        echo "== preflight gamescope Vulkan: $_bl_vk_instance"
        rm -f "$_bl_smoke_log"
        exit 85
      fi
      rm -f "$_bl_smoke_log"
      exit 81
    fi
    rm -f "$_bl_smoke_log"
    printf '%s\n' "ok $(date -u +%FT%TZ)" >"$BL_MALI_PREFLIGHT_MARKER"
    echo "== preflight Mali Kbase: Vulkan/Zink/gamescope correcto"
  fi
  width=${BL_WIDTH:-1280}
  height=${BL_HEIGHT:-720}
  args=(--backend wayland --expose-wayland -f -W "$width" -H "$height" -w "$width" -h "$height")
  # -r is what gamescope advertises as the refresh rate, and what a game reads as the display's.
  # Left unset it defaults to 60, so a 120 Hz panel offers only 60 Hz in game settings. The FPS
  # limiter wins when it is on (it is a deliberate cap); otherwise use the panel's own rate.
  if [ "${BL_FPS:-0}" -gt 0 ]; then
    args+=(-r "$BL_FPS")
  elif [ "${BL_REFRESH:-0}" -gt 0 ]; then
    args+=(-r "$BL_REFRESH")
  fi
  [ "$mode" = steam ] && args+=(-e)
  # A game that resizes its own window when it loses focus (the Steam menu opening over it) comes
  # back smaller, and gamescope draws a window that is not flagged fullscreen at its own size in
  # the top-left corner. Forcing every window to the output's size keeps it filling the screen.
  # BL_GAMESCOPE_FORCE_FULLSCREEN=0 turns it off.
  [ "$mode" = steam ] && [ "${BL_GAMESCOPE_FORCE_FULLSCREEN:-1}" = 1 ] && args+=(--force-windows-fullscreen)
  # HDR10: the app opened its compositor's colour-management gate for this session (BL_HDR=1);
  # gamescope then offers HDR to its clients through the same wp_color_manager_v1 it binds on ours.
  [ "${BL_HDR:-0}" = 1 ] && args+=(--hdr-enabled)
  # Deck mode's performance overlay (Quick Access Menu → Performance → Overlay Level) is drawn by
  # mangoapp, which gamescope starts beside the client; the client sets the level by rewriting
  # MANGOHUD_CONFIGFILE. The apk stages Valve's aarch64 build (tools/mangoapp) - without it the menu
  # still offers the levels and nothing appears. Starts hidden until the client writes a level.
  # BL_MANGOAPP=0 turns it off (one community build found Valve's mangoapp crashing on Turnip).
  if [ "$mode" = steam ] && [ "${BL_STEAMDECK:-0}" = 1 ] && [ "${BL_MANGOAPP:-1}" = 1 ] \
     && [ "${BL_STEAM_UI:-}" != desktop ] && command -v mangoapp >/dev/null 2>&1; then
    MANGOHUD_CONFIGFILE=$(mktemp /tmp/mangohud.XXXXXXXX)
    echo no_display > "$MANGOHUD_CONFIGFILE"
    export MANGOHUD_CONFIGFILE STEAM_USE_MANGOAPP=1 STEAM_MANGOAPP_PRESETS_SUPPORTED=1 STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1
    args+=(--mangoapp)
    echo "== gamescope: mangoapp activado ($(command -v mangoapp), configuración $MANGOHUD_CONFIGFILE)"
  fi
  export BL_INSIDE=1
  exec gamescope "${args[@]}" -- "$0" "$mode" "$@"
fi

# gamescope manages X windows: toolkits go through Xwayland, not gamescope's own Wayland socket.
export GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb SDL_VIDEODRIVER=x11
# gamescope's reaper waits for every process left under it before the compositor comes down. A
# process a game left behind - a Wine service blocked on a server that is already gone - is
# reparented there when the client exits, and the screen stays black on it for good. Nothing of
# the session outlives the program it was started for.
reap_orphans() {
  local round p stat pid left
  for round in 1 2 3 4 5; do
    left=
    for p in /proc/[0-9]*; do
      pid=${p#/proc/}
      [ "$pid" = "$$" ] && continue
      stat=$(cat "$p/stat" 2>/dev/null) || continue
      stat=${stat##*) }
      set -- $stat
      [ "${2:-}" = "$PPID" ] && left="$left $pid"
    done
    [ -n "$left" ] || return 0
    echo "== procesos restantes:$left"
    kill -9 $left 2>/dev/null
    sleep 0.2
  done
}

case $mode in
  run)
    target=${1:?program path}
    shift
    cores=$(program_cores)
    if [ -n "$cores" ]; then
      echo "== núcleos del programa: $cores"
      taskset -cp "$cores" $$ >/dev/null 2>&1 || true
    fi
    case ${target,,} in
      *.appimage)
        export APPIMAGE_EXTRACT_AND_RUN=1
        chmod +x "$target" 2>/dev/null
        exec "$target" "$@"
        ;;
      *.sh)
        exec bash "$target" "$@"
        ;;
      *)
        chmod +x "$target" 2>/dev/null
        cd "$(dirname "$target")" && exec "$target" "$@"
        ;;
    esac
    ;;
  steam)
    step "comprobando el cliente de Steam (la primera ejecución lo descarga)"
    bannerlator-steam-install || exit $?
    step "cliente de Steam listo"
    steam_root=$XDG_DATA_HOME/Steam
    # Register the card library (bound at /mnt/bannerlator-sd) with the client - internal storage is
    # its main library already - and the ARM64 Proton that lets it launch the Windows ones.
    # A request left in ~/.bl-proton-extra installs a third-party Proton before the client starts,
    # so it is in the Compatibility dropdown the first time the user looks. One per line, each the
    # arguments to bannerlator-proton-extra: "ge", "cachyos", "ge --tag GE-Proton11-7", or a URL.
    # Hundreds of megabytes each, so it is only ever done on request, and the line is dropped once
    # it has succeeded - a failed download stays and is retried next session.
    if [ -s "$HOME/.bl-proton-extra" ]; then
      _bl_left=$HOME/.bl-proton-extra.left
      : > "$_bl_left"
      while read -r _bl_extra || [ -n "$_bl_extra" ]; do
        case ${_bl_extra# } in ""|"#"*) continue ;; esac
        step "instalando Proton '$_bl_extra' (descarga grande)"
        if bannerlator-proton-extra "$steam_root" $_bl_extra; then
          step "Proton '$_bl_extra' instalado"
        else
          step "falló Proton '$_bl_extra'; se reintentará en la próxima sesión"
          echo "$_bl_extra" >> "$_bl_left"
        fi
      done < "$HOME/.bl-proton-extra"
      mv -f "$_bl_left" "$HOME/.bl-proton-extra"
    fi
    # steam:// URLs left in ~/.bl-steam-urls are handed to the client on its command line. The app
    # writes one when the user asks for a Proton that is one of Valve's own depots rather than a
    # tarball: those are not files anywhere, the client fetches them like any other app. One per
    # line, and the file is cleared once they have been passed on - the client either acts on a URL
    # or it does not, and repeating it every session would re-ask forever.
    if [ -s "$HOME/.bl-steam-urls" ]; then
      while read -r _bl_url || [ -n "$_bl_url" ]; do
        case ${_bl_url# } in steam://*) ;; *) continue ;; esac
        step "enviando $_bl_url al cliente"
        set -- "$@" "$_bl_url"
      done < "$HOME/.bl-steam-urls"
      rm -f "$HOME/.bl-steam-urls"
    fi
    # Cores for the client itself. Steam pins its own interface renderer to a subset - on the
    # device it took 5 of 8, leaving out both little cores and the fastest one - which is a
    # reasonable thing to do while a game is running and the wrong thing when the client is all
    # there is. BL_CLIENT_CPUS overrides it. Re-applied on a beat because steamwebhelper spawns
    # children continuously and each one inherits Steam's choice, not ours.
    if [ -n "${BL_CLIENT_CPUS:-}" ]; then
      step "núcleos del cliente: $BL_CLIENT_CPUS"
      (
        for _ in $(seq 1 720); do
          for _p in $(pgrep -f 'steamwebhelper|steamrtarm64/steam|gamescope' 2>/dev/null); do
            taskset -cp "$BL_CLIENT_CPUS" "$_p" >/dev/null 2>&1 || true
          done
          sleep 5
        done
      ) &
    fi

    step "registrando la biblioteca de juegos de la aplicación en Steam"
    bannerlator-steam-library "$steam_root" || true
    step "configurando la herramienta de compatibilidad Proton ARM64"
    bannerlator-steam-compat "$steam_root" || true
    # The user's own games, as non-Steam shortcuts under that tool; the list is written by the app
    # each session (empty = the app's earlier entries are removed, the client's own are kept).
    if [ -n "${BL_ADDED_GAMES:-}" ]; then
      step "añadiendo los juegos propios de la aplicación a la biblioteca de Steam"
      bannerlator-steam-shortcuts "$steam_root" "$BL_ADDED_GAMES" || true
    fi
    # Steam runs a game's shared redistributables inside its prefix on first launch; marking
    # them as already run keeps those x86 installers from starting under emulation at all.
    bannerlator-seed-redists "$steam_root" || true
    # The compatibility tool runs Valve's arm64 Proton, which the client fetches like any depot.
    # Asked for on the command line the first time, so a Windows title has it before it is needed.
    if [ ! -f "$steam_root/steamapps/appmanifest_4427310.acf" ]; then
      step "solicitando al cliente la descarga de Proton ARM64"
      set -- "$@" steam://install/4427310
      # Ported from Bannerlator (bannerlator-session, device-proven 2026-09-22). The client decides
      # a title's compatibility tool when the title is installed and keeps that decision for the
      # rest of its run, and the tool is set up before the client comes up. So once the depot has
      # fully landed, restart the client once - its own -shutdown, then the loop below, which knows
      # the marker - and every title installed from then on runs through the tool, with the
      # refreshed tool list and defaults, and no second launch by the user. A first run only: with
      # the depot present at session start nothing here is armed.
      (
        _bl_acf="$steam_root/steamapps/appmanifest_4427310.acf"
        for _ in $(seq 1 360); do
          sleep 10
          # StateFlags 4 = fully installed; a moment more for the client to finish its bookkeeping.
          if grep -q '"StateFlags"[[:space:]]*"4"' "$_bl_acf" 2>/dev/null; then
            sleep 10
            bannerlator-steam-compat "$steam_root" >/dev/null 2>&1 || true
            step "capa de compatibilidad instalada: reiniciando Steam una vez"
            : > "$HOME/.bl-restart-once"
            "$steam_root/steamrtarm64/steam" -shutdown >/dev/null 2>&1 || true
            exit 0
          fi
        done
      ) &
      # A client that starts signed out drops that request - on a fresh install nobody has signed
      # in yet - so the install dialog only appeared after the user restarted the client by hand.
      # With no remembered sign-in, ask again once the sign-in has happened: the client binary
      # started a second time with a URL hands it to the running instance and exits.
      #
      # The request is also dropped while the client is still in its post-logon compat phase (it
      # probes every registered tool then): with publicbeta 1790380355 that phase took 27 s and a
      # request sent 15 s after sign-in vanished (2026-09-26, no dialog; 1790121765 was done in
      # time). So wait for the client to say the phase is over ("Waiting for compat in post-logon
      # took" in its console log; at most 90 s if it never does), then ask - and ask again, twice
      # at most, if no install has started a minute later.
      if ! grep -q '"RememberPassword"[[:space:]]*"1"' "$steam_root/config/loginusers.vdf" 2>/dev/null; then
        (
          _bl_acf="$steam_root/steamapps/appmanifest_4427310.acf"
          _bl_conn="$steam_root/logs/connection_log.txt"
          _bl_cons="$steam_root/logs/console_log.txt"
          _bl_from=$(stat -c %s "$_bl_conn" 2>/dev/null || echo 0)
          _bl_cfrom=$(stat -c %s "$_bl_cons" 2>/dev/null || echo 0)
          for _ in $(seq 1 180); do
            sleep 10
            [ -f "$_bl_acf" ] && exit 0
            if tail -c +$((_bl_from + 1)) "$_bl_conn" 2>/dev/null | grep -q "RecvMsgClientLogOnResponse() : processing complete"; then
              for _ in $(seq 1 45); do
                tail -c +$((_bl_cfrom + 1)) "$_bl_cons" 2>/dev/null | grep -q "Waiting for compat in post-logon took" && break
                sleep 2
              done
              for _bl_try in 1 2 3; do
                sleep 10
                [ -f "$_bl_acf" ] && exit 0
                step "sesión iniciada: solicitando de nuevo Proton ARM64 (intento $_bl_try de 3)"
                "$steam_root/steamrtarm64/steam" steam://install/4427310 >/dev/null 2>&1 || true
                sleep 50
              done
              exit 0
            fi
          done
        ) &
      fi
    fi
    # The tool is registered before the client starts and finds the depot at launch time, so
    # nothing here waits for a download. What can still change under a running client is which
    # titles are installed: a title installed this session gets the client's own per-app Proton
    # choice, which it cannot start. Refresh the per-app entries every so often; the registrar is
    # idempotent, so a repeat costs nothing.
    # The seeder has the same problem and a worse consequence. It marks the shared redistributables
    # as already run in each prefix that exists, and a game's prefix is not created until the
    # client launches it - so a title played for the first time this session was never covered, and
    # its install scripts run for real. That is exactly the hang the seeder exists to prevent: Need
    # for Speed Payback sat on "Running install script" with vcredist_x86.exe blocked in pipe_read,
    # holding both ends of a pipe nobody would write to, while the client waited for it to exit.
    # Seeding again on the same beat covers a prefix the moment it appears.
    # The seeder runs on a shorter beat than the registrar because it is racing something. The
    # client creates a prefix when it launches a title and runs that title's install scripts
    # moments later, so the seeder has only that gap to mark the redistributables as already run.
    # It stamps each prefix it has covered and skips it thereafter, so the extra passes cost
    # almost nothing.
    # The drawer's "Stretch games to fill the screen" works live: the app writes its choice to
    # ~/.droiddeck-fill, and each change goes to gamescope as GAMESCOPE_FORCE_WINDOWS_FULLSCREEN on
    # the root window, which it watches. What gamescope was started with is where this begins.
    (
      last=${BL_GAMESCOPE_FORCE_FULLSCREEN:-1}
      while :; do
        sleep 1
        want=$(cat "$HOME/.droiddeck-fill" 2>/dev/null) || continue
        case $want in 0|1) ;; *) continue ;; esac
        [ "$want" = "$last" ] && continue
        if xprop -root -f GAMESCOPE_FORCE_WINDOWS_FULLSCREEN 32c -set GAMESCOPE_FORCE_WINDOWS_FULLSCREEN "$want" 2>/dev/null; then
          echo "== estirar juegos para llenar la pantalla: $want (en vivo)"
          last=$want
        fi
      done
    ) &
    (
      beat=0
      for _ in $(seq 1 720); do
        sleep 5
        bannerlator-seed-redists "$steam_root" >/dev/null 2>&1 || true
        beat=$((beat + 1))
        if [ "$((beat % 3))" -eq 0 ]; then
          bannerlator-steam-compat "$steam_root" >/dev/null 2>&1 || true
        fi
      done
    ) &
    # Debug aid while the runtime is being brought up: an app id dropped in ~/.bl-autolaunch is
    # handed to the client as a rungameid URL, so a launch can be reproduced without touching the
    # screen. Removed once the runtime is stable.
    if [ -s "$HOME/.bl-autolaunch" ]; then
      _bl_app=$(cat "$HOME/.bl-autolaunch")
      # A bare app id runs the game; a full steam:// URL is passed through, which is how a
      # validate or an install is driven without touching the screen.
      case $_bl_app in
        steam://*) _bl_url=$_bl_app ;;
        *) _bl_url=steam://rungameid/$_bl_app ;;
      esac
      echo "== inicio automático $_bl_url"
      set -- "$@" "$_bl_url"
    fi
    # The client builds Settings > Internet and its connection indicator on NetworkManager, which
    # it looks for on the SYSTEM bus as it starts. This runtime has neither, so the page failed
    # ("StartScanningForNetworks is not a function") under a header that showed no connection even
    # while downloads ran. A system bus and a stand-in that reports Android's connection - and
    # refuses what it cannot do, since the app has no say over Wi-Fi - answer what the client asks.
    # The bus config is written here rather than shipped, so a runtime installed earlier gets this
    # from the app's copy of the session scripts without a re-host. (WinNative, maxjivi05, e7a224ae.)
    if command -v dbus-daemon >/dev/null 2>&1 && command -v bannerlator-netmanager >/dev/null 2>&1; then
      mkdir -p /run/dbus /usr/local/share/bannerlator
      cat > /usr/local/share/bannerlator/system-bus.conf <<'BUSCONF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>system</type>
  <listen>unix:path=/run/dbus/system_bus_socket</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow user="*"/>
    <allow own="*"/>
    <allow send_destination="*"/>
    <allow receive_sender="*"/>
  </policy>
</busconfig>
BUSCONF
      rm -f /run/dbus/system_bus_socket
      dbus-daemon --config-file=/usr/local/share/bannerlator/system-bus.conf --nofork --nopidfile &
      system_bus=$!
      for _ in $(seq 1 50); do
        [ -S /run/dbus/system_bus_socket ] && break
        sleep 0.1
      done
      if [ -S /run/dbus/system_bus_socket ]; then
        bannerlator-netmanager &
        netmanager=$!
        echo "== red: bus del sistema activo; sustituto de NetworkManager en ejecución"
      else
        echo "== red: el bus del sistema no inició; el cliente mostrará que no hay conexión"
      fi
    else
      echo "== red: este runtime no incluye dbus-daemon o netmanager; el cliente mostrará que no hay conexión"
    fi

    export STEAM_RUNTIME=1
    export LD_LIBRARY_PATH=$steam_root/steamrtarm64:$steam_root/steamrtarm64/panorama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export SDL_VIDEO_X11_DGAMOUSE=0
    # Native-Linux x86 games go through Valve's FEX compat tool, which runs FEX with FEX_PORTABLE=1
    # - that makes FEX look for its config next to the binary, while the tool writes one into the
    # app's compatdata instead. FEX therefore starts with no rootfs, every x86_64 library lookup
    # falls through to the host, and the guest shell dies on libreadline before the game is reached.
    # FEX_ROOTFS names it outright and is read whatever the config situation.
    [ -d /usr/share/guestos/fex-mesa ] && export FEX_ROOTFS=/usr/share/guestos/fex-mesa
    # Decky is optional and session scoped: the app's marker opts in, and this supervisor is
    # reaped with the client session. Native ARM64 runs directly. A legacy x86_64 asset is used
    # only when its recorded architecture and this guest's existing FEX installation agree.
    decky_loader=$HOME/homebrew/services/PluginLoader
    if [ -f "$HOME/.droiddeck-decky-enabled" ] && [ -x "$decky_loader" ]; then
      decky_arch=$(cat "$HOME/homebrew/services/.droiddeck-decky-arch" 2>/dev/null || echo unknown)
      if [ "$decky_arch" = arm64 ] || { [ "$decky_arch" = x86_64 ] && [ -x /usr/bin/FEX ] && [ -n "${FEX_ROOTFS:-}" ]; }; then
        (
          decky_child=
          decky_stop() { [ -z "$decky_child" ] || kill "$decky_child" 2>/dev/null; [ -z "$decky_child" ] || wait "$decky_child" 2>/dev/null; exit 0; }
          trap decky_stop TERM INT HUP
          decky_exits=0
          while :; do
            if [ "$decky_arch" = x86_64 ]; then /usr/bin/FEX "$decky_loader" >>"$HOME/homebrew/services/PluginLoader.log" 2>&1 &
            else "$decky_loader" >>"$HOME/homebrew/services/PluginLoader.log" 2>&1 &
            fi
            decky_child=$!
            decky_status=0
            wait "$decky_child" || decky_status=$?
            decky_child=
            decky_exits=$((decky_exits + 1))
            if [ "$decky_exits" -ge 5 ]; then
              echo "== Decky: detenido después de $decky_exits salidas del loader (último estado $decky_status)"
              break
            fi
            decky_delay=$((decky_exits * 3))
            echo "== Decky: el loader salió con estado $decky_status; reinicio $((decky_exits + 1))/5 en ${decky_delay}s"
            sleep "$decky_delay"
          done
        ) &
        decky_supervisor=$!
        echo "== Decky: supervisor de sesión iniciado ($decky_arch)"
      else
        echo "== Decky: la arquitectura del loader instalado no es compatible con este guest; no se iniciará"
      fi
    fi
    # The client exits 42 when it has updated itself and wants a fresh start (steam.sh does this).
    # BL_STEAM_UI=desktop = the client's desktop UI (a window, the library as a list), which the
    # desktop's launchers ask for; gamescope shows one window at a time and the game takes over.
    _bl_ui=(-gamepadui)
    [ "${BL_STEAM_UI:-}" = desktop ] && _bl_ui=()
    # Deck mode (BL_STEAMDECK=1, the Steam page's Client settings): -steamdeck is the flag that puts
    # the Quick Access Menu and the Deck settings pages on screen; the QAM's performance overlay
    # controls stay greyed out without -steamos3, as SteamOS and Armada launch it. -steamos3 makes
    # the client manage itself as SteamOS does - it calls steamos-select-branch and writes
    # steamdeck_stable to package/beta, and a branch on disk that loses to the -clientbeta below
    # is an update that never installs: exit 42, a restart, for ever (Bannerlator 38996ea1). The
    # loop below puts package/beta back before every start. The SteamOS helpers the client calls
    # in this mode are staged as no-op stubs under /usr/bin.
    if [ "${BL_STEAMDECK:-0}" = 1 ] && [ "${BL_STEAM_UI:-}" != desktop ]; then
      _bl_ui+=(-steamdeck -steamos3)
      # The QAM's Scaling Filter lists NVIDIA Image Scaling only when told gamescope has it (it does).
      export STEAM_GAMESCOPE_NIS_SUPPORTED=1
      echo "== Steam: modo Deck activado (-steamdeck -steamos3)"
    fi
    # What a killed session leaves behind. Android ends sessions without warning (backgrounding, the
    # low-memory killer), and the client then finds .crash - opening its update UI on the spinner -
    # and the web helper's Singleton* locks in htmlcache, owned by a process that is gone, which can
    # leave the Gamepad UI blank. No client or helper is running at this point in a session.
    if ! pgrep -f 'steamwebhelper|steamrtarm64/steam' >/dev/null 2>&1; then
      _stale=""
      for _f in "$steam_root/.crash" "$steam_root/steam.pid" \
                "$steam_root/config/htmlcache/SingletonLock" "$steam_root/config/htmlcache/SingletonCookie" \
                "$steam_root/config/htmlcache/SingletonSocket"; do
        if [ -e "$_f" ] || [ -L "$_f" ]; then rm -f "$_f" && _stale="$_stale ${_f##*/}"; fi
      done
      [ -n "$_stale" ] && echo "== Steam: se limpiaron restos de una sesión anterior:$_stale"
      unset _stale _f
    fi
    # The client branch. publicbeta is what every session has run on; steamdeck_publicbeta is the
    # channel Armada bootstraps its ARM64 client from. Whatever wrote package/beta, the branch on
    # disk has to agree with the one forced here - a disagreement is the restart loop above, and
    # it is silent apart from rc=42 in this log.
    # Checked before every start, not once: the client rewrites package/beta during its own run,
    # and a restart below (rc=42, or the one after the ARM64 Proton lands) would otherwise start it
    # again on the branch it just wrote.
    steam_channel=${BL_STEAM_CHANNEL:-publicbeta}
    steam_beta=$steam_root/package/beta
    if [ -n "${BL_ADDED_GAMES:-}" ] && [ -f "$BL_ADDED_GAMES" ]; then
      bannerlator-steam-games watch "$steam_root" "$BL_ADDED_GAMES" &
      games_watcher=$!
    fi
    echo "== argumentos de Steam: ${_bl_ui[*]} -clientbeta $steam_channel -no-cef-sandbox -cef-force-gpu -cef-ozone-platform=x11 -cef-use-gl=angle -cef-use-angle=vulkan $*"
    # An update that cannot install asks for a restart (rc=42) every time; the count is capped so a
    # session can never again loop in silence, which reads as a menu opening and closing by itself.
    steam_updates=0
    steam_zero_restarts=0
    rm -f "$HOME/.bl-stop-requested"
    if [ -n "${BL_LAUNCH_DIR:-}" ] && [ -d "$BL_LAUNCH_DIR" ]; then
      rm -f "$BL_LAUNCH_DIR/steam-stop"
      (
        while :; do
          if [ -e "$BL_LAUNCH_DIR/steam-stop" ]; then
            rm -f "$BL_LAUNCH_DIR/steam-stop"
            : > "$HOME/.bl-stop-requested"
            echo "== Steam: la aplicación solicitó una salida limpia"
            "$steam_root/steamrtarm64/steam" -shutdown >/dev/null 2>&1 || true
            exit 0
          fi
          sleep 0.5
        done
      ) &
      stop_watcher=$!
    fi
    while :; do
      rm -f "$HOME/.bl-restart-once"
      if [ -f "$steam_beta" ] && [ "$(cat "$steam_beta" 2>/dev/null)" != "$steam_channel" ]; then
        echo "== Steam: la rama del cliente en disco era '$(cat "$steam_beta" 2>/dev/null)'; se ajustó a '$steam_channel' para coincidir con -clientbeta"
        echo "$steam_channel" > "$steam_beta"
      fi
      step "iniciando el cliente de Steam${BL_STEAM_UI:+ ($BL_STEAM_UI UI)}"
      "$steam_root/steamrtarm64/steam" "${_bl_ui[@]}" -clientbeta "$steam_channel" \
        -no-cef-sandbox -cef-force-gpu -cef-ozone-platform=x11 \
        -cef-use-gl=angle -cef-use-angle=vulkan "$@"
      rc=$?
      echo "== Steam terminó rc=$rc"
      collect_steam_logs
      if [ -n "${BL_ADDED_GAMES:-}" ] && [ -f "$BL_ADDED_GAMES" ]; then
        bannerlator-steam-shortcuts "$steam_root" "$BL_ADDED_GAMES" || true
      fi
      if [ -f "$HOME/.bl-stop-requested" ]; then
        rm -f "$HOME/.bl-stop-requested" "$HOME/.bl-restart-once"
        break
      fi
      # The session asked for this exit (the ARM64 Proton landed): start again, without the URL
      # arguments, which were acted on. Not counted against the update cap.
      if [ -f "$HOME/.bl-restart-once" ]; then
        echo "== Steam: reiniciando una vez para que la nueva capa de compatibilidad aparezca en las listas del cliente"
        set --
        continue
      fi

      # Some Steam bootstrap builds hand the real client to a detached child and let the launcher
      # process return 0. gamescope is supervising this script, not that detached child; breaking
      # here therefore closed the whole session before the first frame. If Steam is still alive,
      # keep this script alive as its supervisor until the handed-off client really ends.
      if [ "$rc" -eq 0 ]; then
        _bl_handoff=0
        for _ in $(seq 1 20); do
          if pgrep -f 'steamwebhelper|steamrtarm64/steam' >/dev/null 2>&1; then
            _bl_handoff=1
            break
          fi
          sleep 0.25
        done
        if [ "$_bl_handoff" -eq 1 ]; then
          step "Steam transfirió el arranque a un proceso secundario; esperando al cliente"
          while pgrep -f 'steamwebhelper|steamrtarm64/steam' >/dev/null 2>&1; do
            [ -f "$HOME/.bl-stop-requested" ] && break
            sleep 1
          done
          echo "== Steam: el proceso secundario transferido terminó"
          break
        fi

        # A bootstrap/update can also replace files and ask for a fresh invocation by simply
        # returning 0. Retry only a few times so a genuinely broken client never loops forever.
        steam_zero_restarts=$((steam_zero_restarts + 1))
        if [ "$steam_zero_restarts" -le 3 ]; then
          step "Steam cerró el bootstrap sin cliente activo; reintentando ($steam_zero_restarts/3)"
          set --
          sleep 2
          continue
        fi
        echo "== Steam: rc=0 sin cliente activo después de $steam_zero_restarts intentos"
        rc=83
        break
      fi

      [ "$rc" -eq 42 ] || break
      steam_updates=$((steam_updates + 1))
      if [ "$steam_updates" -ge 3 ]; then
        echo "== Steam: solicitó reiniciar por una actualización $steam_updates veces y no la está instalando; la sesión se detiene aquí para evitar un bucle"
        break
      fi
      # The URL arguments were acted on the first time; a restart must not repeat them.
      set --
    done
    if [ -n "${stop_watcher:-}" ]; then
      kill "$stop_watcher" 2>/dev/null || true
      wait "$stop_watcher" 2>/dev/null || true
    fi
    if [ -n "${games_watcher:-}" ]; then
      kill "$games_watcher" 2>/dev/null || true
      wait "$games_watcher" 2>/dev/null || true
    fi
    if [ -n "${decky_supervisor:-}" ]; then
      kill "$decky_supervisor" 2>/dev/null || true
      wait "$decky_supervisor" 2>/dev/null || true
      echo "== Decky: supervisor de sesión detenido"
    fi
    _bl_jobs=$(jobs -p)
    [ -n "$_bl_jobs" ] && kill $_bl_jobs 2>/dev/null
    reap_orphans
    exit "$rc"
    ;;
  *)
    echo "bannerlator-session: unknown mode '$mode'" >&2
    exit 64
    ;;
esac
