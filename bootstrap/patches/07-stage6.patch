-def ini_section(lines, name):
-    """(start, end) line indices of [name]'s body, or None."""
-    start = None
-    for i, l in enumerate(lines):-        t = l.strip()
-        if t.startswith("[") and t.endswith("]"):
-            if start is not None:
-                return start, i
-            if t[1:-1].strip() == name:
-                start = i + 1
-    return (start, len(lines)) if start is not None else None
