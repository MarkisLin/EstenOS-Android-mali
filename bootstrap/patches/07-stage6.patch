-    if not os.path.isabs(folder):
-        folder = os.path.join(os.path.dirname(os.path.dirname(ini)), folder)
-    current = ini_get(ini, "Filenames", "BIOS")
-    if current and os.path.isfile(os.path.join(folder, current)):
-        return
-    try:
-        # A PS2 BIOS dump is 4 MiB (a few are 8); the .nvm/.mec files beside it are not dumps.
-        dumps = sorted(f for f in os.listdir(folder)
-                       if os.path.isfile(os.path.join(folder, f)) and 4 << 20 <= os.path.getsize(os.path.join(folder, f)) <= 8 << 20)
-    except OSError:
-        return
-    if not dumps:
-        return
-    us = [f for f in dumps if any(t in f.lower() for t in ("usa", "(us)", "(us,", "ntsc-u"))]
