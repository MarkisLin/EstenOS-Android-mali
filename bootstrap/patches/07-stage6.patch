-def patch_ini_section(path, section, body, what, needle="SDL-", require=None, done="Player 1 on the controller"):
-    """Add body's lines to [section] of an ini the emulator wrote itself, unless the section
-    already binds a controller (needle). Missing file: nothing - the emulator writes its own
-    defaults on first run and this runs again."""
-    if not os.path.isfile(path):
-        return
-    with open(path, encoding="utf-8", errors="replace") as f:
-        text = f.read()
-    if require and require not in text:
-        return
-    lines = text.splitlines()
-    span = ini_section(lines, section)
-    if span and any(needle in l for l in lines[span[0]:span[1]]):
-        return
-    new = body.strip("\n").splitlines()
-    if span:
-        # The controller type the emulator already wrote stays; only bindings are added.
-        have = {l.split("=", 1)[0].strip() for l in lines[span[0]:span[1]] if "=" in l}
-        new = [l for l in new if not (l.split("=", 1)[0].strip() == "Type" and "Type" in have)]
-        end = span[1]
-        while end > span[0] and not lines[end - 1].strip():
-            end -= 1
-        lines[end:end] = new
-    else:
-        lines += ["", f"[{section}]"] + new
-    with open(path + ".tmp", "w", encoding="utf-8") as f:
-        f.write("\n".join(lines) + "\n")
-    os.replace(path + ".tmp", path)
-    print(f"bannerlator-pad-defaults: {what}: {done} ({path})")
