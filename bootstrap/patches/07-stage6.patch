new file mode 100644
index 0000000..b77913d
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/core/MobilePerformance.kt
@@ -0,0 +1,98 @@
+package com.droiddeck.launcher.core
+
+import android.app.ActivityManager
+import android.content.Context
+import android.os.Build
+import android.os.PowerManager
+
+/**
+ * Conservative mobile-first defaults for a Steam session.
+ *
+ * The important rule is that "Automático" must never assume a phone is fast just because it can
+ * expose Vulkan.  GPU memory is shared system RAM on the Mali devices this fork targets, and Steam
+ * itself (CEF + FEX + gamescope) has a meaningful fixed cost before a game starts.  The automatic
+ * plan therefore uses only stable Android signals we can query without benchmarks or root and
+ * deliberately tops out at the balanced plan.  Users can opt into quality manually.
+ */
+object MobilePerformance {
+    const val AUTO = "auto"
+    const val SAVER = "saver"
+    const val BALANCED = "balanced"
+    const val QUALITY = "quality"
+
+    data class Plan(
+        val id: String,
+        val label: String,
+        /** Maximum render height used when the user left resolution on Automatic. */
+        val maxHeight: Int,
+        /** gamescope refresh/FPS cap. 0 means use the panel/session refresh. */
+        val targetFps: Int,
+        /** Reduce glibc allocator arena proliferation on memory-constrained devices. */
+        val lowMemory: Boolean,
+        val reason: String,
+    )
+
+    private const val GIB = 1024L * 1024L * 1024L
+
+    fun plan(context: Context, selected: String = AUTO): Plan = when (selected) {
+        SAVER -> saver("seleccionado manualmente")
+        BALANCED -> balanced("seleccionado manualmente")
+        QUALITY -> quality("seleccionado manualmente")
+        else -> automatic(context)
+    }
+
+    fun automatic(context: Context): Plan {
+        val am = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val info = ActivityManager.MemoryInfo()
+        am.getMemoryInfo(info)
+        val total = info.totalMem
+
+        // ActivityManager.isLowRamDevice is the platform's own coarse signal.  The explicit RAM
+        // threshold also catches cheap devices whose OEM did not mark them low-RAM.  4.5 GiB gives
+        // 4 GiB phones enough headroom for Android + shared GPU memory + Steam/Proton.
+        val thermal = if (Build.VERSION.SDK_INT >= 29) {
+            runCatching { (context.getSystemService(Context.POWER_SERVICE) as PowerManager).currentThermalStatus }.getOrDefault(PowerManager.THERMAL_STATUS_NONE)
+        } else PowerManager.THERMAL_STATUS_NONE
+
+        return automaticForSignals(total, am.isLowRamDevice, thermal)
+    }
+
+    /** Pure policy entry point kept testable without Android services. */
+    fun automaticForSignals(totalRam: Long, lowRamDevice: Boolean, thermalStatus: Int): Plan {
+        if (thermalStatus >= PowerManager.THERMAL_STATUS_SEVERE) {
+            return saver("el teléfono ya está caliente al iniciar la sesión")
+        }
+        if (lowRamDevice || totalRam in 1 until (GIB * 9 / 2)) {
+            return saver(if (lowRamDevice) "Android marca el dispositivo como memoria limitada" else "RAM total <= 4,5 GB")
+        }
+
+        // Do not auto-select Quality.  A phone having plenty of RAM says little about sustained GPU
+        // throughput or thermals; 720p/60 is a safer default and users who know the device can opt
+        // into a higher target.
+        return balanced(if (totalRam > 0) "RAM suficiente; perfil móvil conservador" else "perfil móvil conservador")
+    }
+
+    private fun saver(reason: String) = Plan(
+        SAVER, "Ahorro", maxHeight = 540, targetFps = 30, lowMemory = true, reason = reason,
+    )
+
+    private fun balanced(reason: String) = Plan(
+        BALANCED, "Equilibrado", maxHeight = 720, targetFps = 60, lowMemory = false, reason = reason,
+    )
+
+    private fun quality(reason: String) = Plan(
+        QUALITY, "Calidad", maxHeight = 900, targetFps = 0, lowMemory = false, reason = reason,
+    )
+
+    fun totalRamBytes(context: Context): Long = runCatching {
+        val info = ActivityManager.MemoryInfo()
+        (context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager).getMemoryInfo(info)
+        info.totalMem
+    }.getOrDefault(0L)
+
+    fun summary(context: Context, selected: String = AUTO): String {
+        val p = plan(context, selected)
+        val fps = if (p.targetFps > 0) "${p.targetFps} FPS" else "FPS del panel"
+        return if (selected == AUTO) "Automático → ${p.label} · ${p.maxHeight}p · $fps" else "${p.label} · ${p.maxHeight}p · $fps"
+    }
+}
